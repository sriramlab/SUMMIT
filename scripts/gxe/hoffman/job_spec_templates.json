      "frozen": "<COPY_FROZEN_CONTRACT_AND_TASK_WRAPPER_SHA>",
      "qacct_dependencies": [],
      "task_args": {
        "dataset": "full",
        "geno_prefix": "/u/scratch/b/bronsonj/summit_gxe_full_20260808/staged/full/<PLINK_PREFIX>",
        "source_manifest": "<RECORD_FOR_PRIVATE_STAGED_SOURCE_MANIFEST>",
        "staged_source_dir": "/u/scratch/b/bronsonj/summit_gxe_full_20260808/staged/phens",
        "group_manifests": [
          "<AGE_BP_GROUP_RECORD>",
          "<AGE_ASSAY_GROUP_RECORD>",
          "<SEX_WHR_GROUP_RECORD>",
          "<SEX_ASSAY_GROUP_RECORD>"
