      "frozen": "<COPY_FROZEN_CONTRACT_AND_TASK_WRAPPER_SHA>",
      "qacct_dependencies": ["<ONE_COMPLETED_PRODUCTION_SHARD_QACCT_RECORD_PER_SHARD>"],
      "task_args": {
        "cache": "<FEATURE_CACHE_RECORD>",
        "shards": ["<CONTIGUOUS_PRODUCTION_SHARD_MANIFEST_RECORDS_FROM_ZERO>"]
      }
    },
    "score": {
      "kind": "summit.gxe.hoffman_job",
      "schema_version": 1,
      "task": "score",
