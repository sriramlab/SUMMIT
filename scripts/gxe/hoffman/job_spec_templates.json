        "reference": "<B100_REFERENCE_MANIFEST_RECORD>",
        "traits": ["<EXACT_CONFIGURED_TRAITS_IN_ORDER>"]
      }
    },
    "fit": {
      "kind": "summit.gxe.hoffman_job",
      "schema_version": 1,
      "task": "fit",
      "job_name": "gxe_fit_age_bp_dbp",
      "job_root": "/u/scratch/b/bronsonj/summit_gxe_full_20260808/jobs/<NEW_FIT_JOB>",
      "frozen": "<COPY_FROZEN_CONTRACT_AND_TASK_WRAPPER_SHA>",
