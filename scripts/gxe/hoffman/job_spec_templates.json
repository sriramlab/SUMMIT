    "shard": {
      "kind": "summit.gxe.hoffman_job",
      "schema_version": 1,
      "task": "shard",
      "job_name": "gxe_age_bp_s00",
      "job_root": "/u/scratch/b/bronsonj/summit_gxe_full_20260808/jobs/<NEW_SHARD_JOB>",
      "frozen": "<COPY_FROZEN_CONTRACT_AND_TASK_WRAPPER_SHA>",
      "qacct_dependencies": ["<COMPLETED_CACHE_QACCT_RECORD>"],
      "task_args": {
        "geno_prefix": "<PRIVATE_STAGED_PLINK_PREFIX>",
        "group_manifest": "<GROUP_MANIFEST_RECORD>",
        "stage_verification": "<STAGE_VERIFICATION_REPORT_RECORD>",
        "cache": "<FEATURE_CACHE_RECORD>",
